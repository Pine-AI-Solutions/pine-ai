@page "/safir/broadcast"

<PageTitle>ارسال پیام همگانی (سفیر)</PageTitle>

<div class="container-fluid px-3 px-md-4 mt-4">
    <div class="page-header">
        <h4>ارسال پیام همگانی به مشتریان</h4>
        <span class="badge bg-info">سفیر بله</span>
    </div>

    @if (!isConfigured)
    {
        <div class="alert alert-danger">
            تنظیمات سفیر (<code>BaleMessenger:Safir</code> و <code>BaleMessenger:BotId</code>) در سرور API انجام نشده است؛ ارسال ممکن نیست.
        </div>
    }

    @if (status != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold">وضعیت ارسال</h6>
                        <span class="badge @StateBadgeClass(status.State)">@StateText(status.State)</span>
                    </div>
                    @if (status.IsActive)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="CancelAsync" disabled="@isCancelling">
                            @if (isCancelling)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            توقف ارسال
                        </button>
                    }
                    else if (status.CanResume)
                    {
                        <button class="btn btn-warning btn-sm" @onclick="() => ResumeAsync(status.JobId)" disabled="@isResuming">
                            @if (isResuming)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            ادامه ارسال (@status.RemainingRecipients مخاطب باقی‌مانده)
                        </button>
                    }
                </div>

                <div class="progress mb-2" style="height: 22px;">
                    <div class="progress-bar @(status.IsActive ? "progress-bar-striped progress-bar-animated" : string.Empty)"
                         role="progressbar"
                         style="width: @(Percent)%;">
                        @(Percent)%
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3 small mb-2">
                    <span>کل مخاطبین: <strong>@status.TotalRecipients</strong></span>
                    <span>پردازش‌شده: <strong>@status.ProcessedRecipients</strong></span>
                    <span class="text-success">موفق: <strong>@status.SuccessCount</strong></span>
                    <span class="text-danger">ناموفق: <strong>@status.FailedCount</strong></span>
                    @if (status.ImageCount > 0)
                    {
                        <span>تصویر: <strong>@status.ImageCount</strong></span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(status.Message))
                {
                    <div class="alert alert-warning py-2 mb-2">@status.Message</div>
                }

                @if (status.RecentErrors.Count > 0)
                {
                    <details class="mt-2">
                        <summary class="small text-muted">آخرین خطاها (@status.RecentErrors.Count مورد)</summary>
                        <div class="mt-2 p-2 bg-white rounded border small"
                             style="max-height:160px; overflow-y:auto; direction:ltr; text-align:left;">
                            @foreach (var error in status.RecentErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>
    }

    @if (UnfinishedOthers.Count > 0)
    {
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1">ارسال‌های ناتمام</h6>
                <div class="form-text text-muted mb-3">
                    این ارسال‌ها به همه مخاطبین نرسیده‌اند. با «ادامه ارسال» فقط برای مخاطبینی که هنوز پیام را دریافت نکرده‌اند ارسال می‌شود.
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>تاریخ</th>
                                <th>پیام</th>
                                <th>موفق / کل</th>
                                <th>باقی‌مانده</th>
                                <th>وضعیت</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in UnfinishedOthers)
                            {
                                <tr>
                                    <td class="text-nowrap">@job.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td style="max-width:260px;" class="text-truncate" title="@job.TextPreview">
                                        @(job.TextPreview ?? "(فقط تصویر)")
                                        @if (job.ImageCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border">@job.ImageCount تصویر</span>
                                        }
                                    </td>
                                    <td>@job.SuccessCount / @job.TotalRecipients</td>
                                    <td>@job.RemainingRecipients</td>
                                    <td><span class="badge @StateBadgeClass(job.State)">@StateText(job.State)</span></td>
                                    <td class="text-nowrap">
                                        <button class="btn btn-warning btn-sm"
                                                @onclick="() => ResumeAsync(job.JobId)"
                                                disabled="@(isResuming || IsBroadcastActive)">ادامه ارسال</button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => DeleteAsync(job.JobId)"
                                                disabled="@(isResuming || IsBroadcastActive)">حذف</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="mb-4">
                <span class="badge bg-primary fs-6">
                    @(recipientCount.HasValue ? recipientCount.Value.ToString() : "...") مشتری با شماره یکتا
                </span>
                <div class="form-text text-muted mt-2">
                    پیام برای همه شماره‌های یکتای ثبت‌شده در جدول مشتریان ارسال می‌شود.
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">متن پیام</label>
                <textarea class="form-control" rows="6" maxlength="@MaxMessageLength"
                          placeholder="متن پیام را بنویسید..."
                          disabled="@(isSending || IsBroadcastActive)"
                          @bind="messageText" @bind:event="oninput"></textarea>
                <div class="form-text text-muted">@messageText.Length / @MaxMessageLength</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">تصاویر (اختیاری)</label>
                <InputFile @key="inputKey" class="form-control" OnChange="HandleFilesSelected"
                           accept="image/*" multiple
                           disabled="@(isSending || IsBroadcastActive)" />
                <div class="form-text text-muted mt-2">
                    <ul class="mb-0 ps-3">
                        <li>حداکثر @MaxImages تصویر، هر کدام حداکثر @(MaxImageBytes / 1024 / 1024) مگابایت</li>
                        <li>هر تصویر به‌صورت یک پیام جداگانه ارسال می‌شود؛ در صورت وجود تصویر، متن به‌عنوان کپشن تصویر اول ارسال می‌شود</li>
                    </ul>
                </div>

                @if (images.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-3 mt-3">
                        @foreach (var image in images)
                        {
                            <div class="border rounded p-2 text-center bg-white" style="width:150px;">
                                @if (!string.IsNullOrEmpty(image.PreviewDataUrl))
                                {
                                    <img src="@image.PreviewDataUrl" alt="@image.Name"
                                         style="max-width:100%; max-height:110px; object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="text-muted py-4"><span class="bi bi-image fs-2"></span></div>
                                }
                                <div class="small text-truncate mt-1" title="@image.Name" style="direction:ltr;">@image.Name</div>
                                <div class="small text-muted">@FormatSize(image.Content.Length)</div>
                                <button class="btn btn-outline-danger btn-sm mt-1"
                                        @onclick="() => RemoveImage(image)"
                                        disabled="@(isSending || IsBroadcastActive)">حذف</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (showConfirm)
            {
                <div class="alert alert-warning">
                    <div class="fw-semibold mb-2">
                        این پیام برای @(recipientCount?.ToString() ?? "همه") مشتری ارسال می‌شود و پس از شروع قابل بازگشت نیست. ادامه می‌دهید؟
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="ConfirmSendAsync" disabled="@isSending">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            بله، ارسال کن
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="() => showConfirm = false" disabled="@isSending">انصراف</button>
                    </div>
                </div>
            }
            else
            {
                <button class="btn btn-success" @onclick="RequestSend"
                        disabled="@(!CanSend)">
                    <span class="bi bi-send-fill me-1"></span>
                    ارسال به همه مشتریان
                </button>
                @if (IsBroadcastActive)
                {
                    <span class="text-muted small me-2">یک ارسال در حال انجام است.</span>
                }
            }
        </div>
    </div>
</div>
